{
  "name": "prompt-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi extension: keeps your current prompt pinned above the input and renders a live, Claude-Code-style tree of what the agent is doing",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "tui",
    "prompt",
    "activity"
  ],
  "files": [
    "extensions",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/prompt-panel.ts"
    ]
  },
  "scripts": {
    "test": "node tests/prompt-panel/run.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "1.5.0"
  }
}
